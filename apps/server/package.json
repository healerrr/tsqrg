{
  "name": "@aquarium/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/persistence/migrate.ts",
    "db:seed": "tsx src/persistence/seed.ts"
  },
  "dependencies": {
    "@aquarium/core": "workspace:*",
    "@aquarium/protocol": "workspace:*",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.1.0",
    "@fastify/multipart": "9.3.0",
    "@fastify/static": "8.3.0",
    "drizzle-orm": "0.44.7",
    "fastify": "5.6.2",
    "pg": "8.16.3",
    "sharp": "0.34.4",
    "socket.io": "4.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/pg": "8.15.6"
  }
}
