# 生产部署必须替换占位值。仅服务器读取此文件，不使用 VITE_ 前缀。
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://aquarium:REPLACE_DATABASE_PASSWORD@db:5432/aquarium
POSTGRES_PASSWORD=REPLACE_DATABASE_PASSWORD
APP_ORIGIN=https://tank.example.com
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
UPLOAD_DIR=/app/uploads
GAME_TIMEZONE=Asia/Shanghai
RULES_VERSION=1.1.0
LOG_LEVEL=info
OPS_METRICS_TOKEN=REPLACE_WITH_AT_LEAST_24_RANDOM_CHARACTERS
OPERATIONS_CHECK_INTERVAL_MS=60000
SHUTDOWN_DRAIN_MS=35000

# 本地便携数据库的默认连接（不要用于生产）：
# DATABASE_URL=postgresql://aquarium:aquarium_dev@127.0.0.1:55432/aquarium
# LOCAL_DB_PORT=55432
# LOCAL_DB_PASSWORD=aquarium_dev
