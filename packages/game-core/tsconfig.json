{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "skipLibCheck": true, "noEmit": true, "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true, "lib": ["ES2022", "DOM"]
  },
  "include": ["src/**/*.ts", "../../config/*.json"]
}
